# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, add these under Project → Settings → Environment Variables (tick "Sensitive").

# Required ─────────────────────────────────────────────────────────────
# Postgres connection string. On Vercel: Storage → Create Database → Neon (auto-fills DATABASE_URL).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Your private unlock passphrase (12+ characters — a sentence works best).
OWNER_PASSWORD=

# 32+ random characters. Encrypts broker credentials at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
ENCRYPTION_KEY=

# Optional ─────────────────────────────────────────────────────────────
# Enables the nightly Vercel Cron sync (16+ random characters).
CRON_SECRET=

# Enables AI briefings, journal reflections and the coach. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model (defaults to claude-opus-5-5). claude-haiku-5-5 is ~40× cheaper.
AI_MODEL=
