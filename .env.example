# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, add these under Project → Settings → Environment Variables (tick "Sensitive").
# The /setup page generates ENCRYPTION_KEY + CRON_SECRET in your browser as one paste-able block.

# Required ─────────────────────────────────────────────────────────────
# Postgres connection string. On Vercel: Storage → Create Database → Neon (fills DATABASE_URL for you).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# 32+ random characters. Encrypts broker credentials at rest (AES-256-GCM) and derives the one-time setup code.
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
ENCRYPTION_KEY=

# Optional ─────────────────────────────────────────────────────────────
# Enables the nightly Vercel Cron sync (16+ random characters).
CRON_SECRET=

# Enables AI briefings, journal reflections, the Observer case file and the coach. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model (defaults to claude-opus-5-5). claude-haiku-5-5 is far cheaper.
AI_MODEL=

# Your passphrase is chosen inside the app on first launch (stored only as a scrypt hash).
# OWNER_PASSWORD is a legacy alternative and can stay unset.
# OWNER_PASSWORD=
